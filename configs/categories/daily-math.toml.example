# Editorial and institutional discovery. These are discovery surfaces, not
# quotation authority; downstream use must still open and verify the original.
[[sources]]
key = "publication.quanta"
display_name = "Quanta Magazine"
feed_url = "https://api.quantamagazine.org/feed/"
feed_kind = "rss"
priority = 20
enabled = true

[[sources]]
key = "organization.simons-foundation"
display_name = "Simons Foundation"
feed_url = "https://www.simonsfoundation.org/feed/"
feed_kind = "rss"
priority = 30
enabled = true

# Official arXiv category feeds are high-volume discovery surfaces. The
# rss-ai-news scorer should filter them; feed entries are never citation proof.
[[sources]]
key = "archive.arxiv.math-pr"
display_name = "arXiv math.PR — Probability"
feed_url = "https://rss.arxiv.org/rss/math.PR"
feed_kind = "rss"
priority = 30
enabled = true

[[sources]]
key = "archive.arxiv.math-co"
display_name = "arXiv math.CO — Combinatorics"
feed_url = "https://rss.arxiv.org/rss/math.CO"
feed_kind = "rss"
priority = 30
enabled = true

[[sources]]
