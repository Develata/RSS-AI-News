schema_version = "1"

# Quality-first discovery pool for Develata's daily mathematics journal.
# Feed activity is not a quality criterion: a quiet but authoritative archive
# remains enabled as long as the endpoint is healthy and provenance is clear.
[category]
key = "daily-math"
display_name = "Daily Mathematics Discovery"
priority = 10

[category.publish_override]
max_items_per_report = 30
min_importance_score = 0
include_unscored = true

# Broad, first-person mathematical exposition.
[[sources]]
key = "person.terence-tao.whats-new"
display_name = "Terence Tao — What's New"
feed_url = "https://terrytao.wordpress.com/feed/"
feed_kind = "rss"
priority = 10
enabled = true

[[sources]]
key = "person.timothy-gowers.web-log"
display_name = "Timothy Gowers's Weblog"
feed_url = "https://gowers.wordpress.com/feed/"
feed_kind = "rss"
priority = 10
enabled = true

[[sources]]
key = "person.gil-kalai.combinatorics-and-more"
display_name = "Gil Kalai — Combinatorics and More"
feed_url = "https://gilkalai.wordpress.com/feed/"
feed_kind = "rss"
priority = 10
enabled = true

# Theory, combinatorics, probability, computation, and mathematical physics.
[[sources]]
key = "person.luca-trevisan.in-theory"
display_name = "Luca Trevisan — In Theory"
feed_url = "https://lucatrevisan.wordpress.com/feed/"
feed_kind = "rss"
priority = 20
enabled = true

