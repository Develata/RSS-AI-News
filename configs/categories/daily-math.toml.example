# Editorial and institutional discovery. These are discovery surfaces, not
# quotation authority; downstream use must still open and verify the original.
[[sources]]
key = "publication.quanta"
display_name = "Quanta Magazine"
feed_url = "https://api.quantamagazine.org/feed/"
feed_kind = "rss"
priority = 20
enabled = true

[[sources]]
key = "organization.simons-foundation"
display_name = "Simons Foundation"
feed_url = "https://www.simonsfoundation.org/feed/"
feed_kind = "rss"
priority = 30
enabled = true

# Narrow, first-person interview and lecture feeds. Dormancy is acceptable:
# their role is durable mathematical thought rather than a daily news quota.
[[sources]]
key = "interview.quanta-joy-of-why"
display_name = "Quanta — The Joy of Why"
feed_url = "https://joy.quantamagazine.org"
site_url = "https://www.quantamagazine.org/tag/the-joy-of-why/"
feed_kind = "rss"
priority = 10
enabled = true

[[sources]]
key = "lecture.oxford-secrets-of-mathematics"
