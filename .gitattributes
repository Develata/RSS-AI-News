# 强制 LF 行结尾的文件：避免 Windows clone 时 CRLF 污染 shell 解释。
# bash 在 MSYS2 / WSL 下对 CRLF 极其敏感（`set -euo pipefail` 会因 CRLF 失败）。
.githooks/pre-commit text eol=lf
docker/scheduler-entrypoint.sh text eol=lf

# 迁移文件强制 LF（W17-fix2）：sqlx::migrate! 的校验和按原始字节计算，
# autocrlf 在 Windows 检出 CRLF 会让本机构建与 Linux/CI 构建嵌入不同
# 校验和——同一个库被不同平台构建的二进制 migrate 会互报 VersionMismatch。
# 钉 LF 使所有平台构建嵌入相同字节。
migrations/**/*.sql text eol=lf
