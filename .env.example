# Required when [ai].enabled = true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Required for remote publish mode when publish.github_owner is non-empty.
GITHUB_TOKEN=

# Required when any category source uses the {RSSHUB} placeholder.
RSSHUB_BASE_URL=

# Optional. When set, rsshub sources receive this as ?key=... at fetch time.
RSSHUB_ACCESS_KEY=

# Optional process-wide proxy settings.
HTTP_PROXY=
HTTPS_PROXY=

# Optional database override. PostgreSQL deployments should set this.
DATABASE_URL=
