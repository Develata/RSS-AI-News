# Required when [ai].enabled = true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Required for remote publish mode when publish.github_owner is non-empty.
GITHUB_TOKEN=

# Required when any category source uses the {RSSHUB} or {RSSHUB_BASE_URL} placeholder.
RSSHUB_BASE_URL=

# Optional. When set, rsshub sources receive this as ?key=... at fetch time.
RSSHUB_ACCESS_KEY=

# Required when [decision].enabled = true (typed-decision, ADR 0010).
# The variable name is whatever decision.api_key_env names; these are the
# documented defaults for the Laya and Jev providers.
LAYA_API_KEY=
JEV_API_KEY=

# Optional process-wide proxy settings.
HTTP_PROXY=
HTTPS_PROXY=

# Optional database override. PostgreSQL deployments should set this.
DATABASE_URL=
